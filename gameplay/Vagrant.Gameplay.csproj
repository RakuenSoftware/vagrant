<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <RootNamespace>Wol.Games.Vagrant</RootNamespace>
    <AssemblyName>Vagrant.Gameplay</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EmbedAllSources>false</EmbedAllSources>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="installation/retail_digests.json" LogicalName="Wol.Games.Vagrant.Installation.RetailDigests" />
  </ItemGroup>
  <Import Project="$(WolEngineCoreRoot)/WolEngine.Core.props" />
</Project>
