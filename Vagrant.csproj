<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>Wol.Games.Vagrant</RootNamespace>
    <AssemblyName>Vagrant</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GodotApiConfiguration Condition="'$(Configuration)' == 'Release'">Release</GodotApiConfiguration>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="addons/wol_engine/.godot/**/*.cs" />
    <Compile Remove="addons/wol_engine/.dependencies/**/*.cs" />
    <Compile Remove="addons/wol_engine/scripts/**/*.cs" />
    <Compile Remove="addons/wol_engine/tests/**/*.cs" />
    <Compile Remove="addons/wol_engine/obj/**/*.cs" />
    <Compile Remove="addons/wol_engine/bin/**/*.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ExportRelease'">
    <AllowedReferenceRelatedFileExtensions>.dll.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ExportRelease'">
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <Import Project="addons/wol_engine/GodotApi.props" />
</Project>
