<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>Wol.Games.Vagrant</RootNamespace>
    <AssemblyName>Vagrant</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WolEngineTarget Condition="'$(WolEngineTarget)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows-x64</WolEngineTarget>
    <WolEngineTarget Condition="'$(WolEngineTarget)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">macos-universal</WolEngineTarget>
    <WolEngineTarget Condition="'$(WolEngineTarget)' == ''">linux-x64</WolEngineTarget>
    <WolEngineSdkRoot>$(MSBuildProjectDirectory)/addons/wol_engine/platforms/$(WolEngineTarget)</WolEngineSdkRoot>
    <GodotApiConfiguration Condition="'$(Configuration)' == 'Release'">Release</GodotApiConfiguration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ExportRelease'">
    <AllowedReferenceRelatedFileExtensions>.dll.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ExportRelease'">
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="gameplay/**/*.cs;tests/gameplay/**/*.cs" />
    <ProjectReference Include="gameplay/Vagrant.Gameplay.csproj" />
  </ItemGroup>
  <Import Project="$(WolEngineSdkRoot)/WolEngine.props" />
  <Import Project="$(WolEngineSdkRoot)/GodotApi.props" />
</Project>
