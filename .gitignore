# The user's own disc images and anything extracted or converted from them.
# Nothing from the retail disc is ever committed or shipped.
/*.bin
/*.cue
/*.chd
/*.iso
/*.img
/assets/local/

# Godot, .NET and native build output
.godot/
.mono/
bin/
obj/
*.import
*.log

# Local test captures and run output
/test-results/

# Player release archives and private export staging
/dist/
/release-work/

# Python release tooling cache
__pycache__/
*.pyc

# Intentional upstream binary dependencies, maintained as a vendored release.
!/addons/wol_engine/native/bin/
!/addons/wol_engine/native/bin/*
