; Engine configuration file.

config_version=5

[application]

config/name="Vagrant"
config/description="Vagrant Story on the shared wol-engine. Requires the player's own US disc."
run/main_scene="res://scenes/startup/startup.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

RetailContent="*res://runtime/RetailContent.cs"
DisplaySettings="*res://addons/wol_engine/runtime/display/DisplaySettings.cs"
SceneManager="*res://addons/wol_engine/runtime/SceneManager.cs"
InputBindings="*res://addons/wol_engine/runtime/controls/InputBindings.cs"
AudioSettings="*res://runtime/AudioSettings.cs"
CharacterQuality="*res://runtime/CharacterQuality.cs"
FieldLighting="*res://runtime/FieldLighting.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[dotnet]

project/assembly_name="Vagrant"

