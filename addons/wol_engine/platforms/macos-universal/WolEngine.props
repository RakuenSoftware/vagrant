<Project>
  <PropertyGroup>
    <WolEngineConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</WolEngineConfiguration>
    <WolEngineConfiguration Condition="'$(Configuration)' != 'Debug'">Release</WolEngineConfiguration>
    <WolEngineCoreRoot Condition="'$(WolEngineCoreRoot)' == ''">$(MSBuildThisFileDirectory)portable</WolEngineCoreRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="addons/wol_engine/**/*.cs" />
    <Reference Include="WolEngine">
      <HintPath>$(MSBuildThisFileDirectory)managed/$(WolEngineConfiguration)/WolEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="$(WolEngineCoreRoot)/WolEngine.Core.props" />
</Project>
