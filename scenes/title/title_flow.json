{
  "world": {
    "settings": { "mono_sound": false, "vibration": true },
    "title": { "visits": 0 }
  },
  "events": [
    {
      "id": "title",
      "start_action": "title.boot",
      "entry": "publisher",
      "nodes": {
        "publisher": { "transitions": [ { "action": "presentation.finished", "to": "developer" } ] },
        "developer": { "transitions": [ { "action": "presentation.finished", "to": "intro" } ] },
        "intro": {
          "transitions": [
            { "action": "presentation.finished", "effects": [ { "op": "add", "path": [ "title", "visits" ], "value": 1 } ], "to": "menu" }
          ]
        },
        "menu": {
          "transitions": [
            { "action": "title.choice", "when": { "path": [ "choice" ], "scope": "facts", "value": "new_game" }, "to": "new_game" },
            { "action": "title.choice", "when": { "path": [ "choice" ], "scope": "facts", "value": "continue" }, "to": "continue" },
            { "action": "title.choice", "when": { "path": [ "choice" ], "scope": "facts", "value": "timeout" }, "to": "attract" },
            { "action": "settings.sound", "when": { "path": [ "mono" ], "scope": "facts", "value": true },
              "effects": [ { "op": "set", "path": [ "settings", "mono_sound" ], "value": true } ], "to": "menu" },
            { "action": "settings.sound", "when": { "path": [ "mono" ], "scope": "facts", "value": false },
              "effects": [ { "op": "set", "path": [ "settings", "mono_sound" ], "value": false } ], "to": "menu" },
            { "action": "settings.vibration", "when": { "path": [ "enabled" ], "scope": "facts", "value": true },
              "effects": [ { "op": "set", "path": [ "settings", "vibration" ], "value": true } ], "to": "menu" },
            { "action": "settings.vibration", "when": { "path": [ "enabled" ], "scope": "facts", "value": false },
              "effects": [ { "op": "set", "path": [ "settings", "vibration" ], "value": false } ], "to": "menu" }
          ]
        },
        "new_game": { "transitions": [ { "action": "presentation.finished", "to": "field" } ] },
        "field": { "transitions": [] },
        "continue": { "transitions": [ { "action": "presentation.finished", "to": "intro" } ] },
        "attract": { "transitions": [ { "action": "presentation.finished", "to": "intro" } ] }
      }
    }
  ]
}
